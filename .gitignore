# =========================
# CodeVault - Git Ignore
# =========================

# Compiled executable
codevault

# C object files
*.o
*.obj

# Other compiled executables
*.exe
*.out

# Build directories
build/
bin/

# CodeVault runtime repository
# Generated when running: ./codevault init
.codevault/

# Debugging / profiling files
*.d
*.su
*.gcda
*.gcno
*.gcov

# IDE configuration
.vscode/
.vs/
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# Temporary/editor backup files
*.tmp
*.temp
*~
*.swp
*.swo

# Log files
*.log